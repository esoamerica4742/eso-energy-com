# Copy to .env (local) or set as Cloudflare Workers Secrets (production).
# https://supabase.com/dashboard/project/YOUR_PROJECT_REF/settings/api

# --- Supabase (required) ---
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
VITE_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
VITE_SUPABASE_PROJECT_ID="YOUR_PROJECT_REF"
SUPABASE_PUBLISHABLE_KEY="your-anon-key"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-key"
SUPABASE_ANON_KEY="your-anon-key"
VITE_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
# Dashboard -> Settings -> Database (for npm run setup:monnify migrations)
SUPABASE_PROJECT_REF="pndsuzscjedumjhadtio"
# Prefer this over deprecated db.<ref>.supabase.co DATABASE_URL for migrations.
SUPABASE_DB_PASSWORD="your-database-password"
SUPABASE_PROJECT_REF="pndsuzscjedumjhadtio"
# Optional pooler region (default aws-1-eu-west-2) — see Supabase Dashboard -> Connect.
# SUPABASE_POOLER_REGION="aws-1-eu-west-2"
# Optional: https://supabase.com/dashboard/account/tokens — avoids interactive `supabase login`
# SUPABASE_ACCESS_TOKEN="sbp_..."
# Session pooler (IPv4-friendly). Password: Dashboard -> Settings -> Database
# Or omit and set SUPABASE_DB_PASSWORD — apply-eso-pay-migration builds this URL automatically.
DATABASE_URL="postgresql://postgres.pndsuzscjedumjhadtio:YOUR_PASSWORD@aws-1-eu-west-2.pooler.supabase.com:5432/postgres"

# --- Application crypto (Cloudflare Workers Secret) ---
# Generate: openssl rand -hex 32
ENCRYPTION_MASTER_KEY="64_hex_chars_32_bytes"
# Optional during key rotation dual-read:
# ENCRYPTION_MASTER_KEY_V2="64_hex_chars_32_bytes"

# --- Auth / sessions ---
# Generate: openssl rand -base64 64
AUTH_SECRET="minimum_64_characters_random_string_for_session_signing"
AUTH_URL="https://app.eso-energy.com"
# Supabase Auth → URL configuration (required for email confirm):
#   Site URL: https://app.eso-energy.com
#   Redirect URLs: https://app.eso-energy.com/**  (includes /auth/callback?product=...)
TOTP_ISSUER="ESO Energy Command Deck"

# --- Email (magic links via Resend) ---
RESEND_API_KEY="re_xxxxxxxx"

# --- Rate limiting (Upstash Redis) ---
UPSTASH_REDIS_REST_URL="https://xxx.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-token"

# --- WebAuthn (passkeys) ---
WEBAUTHN_RP_ID="app.eso-energy.com"
WEBAUTHN_ORIGIN="https://app.eso-energy.com"

# --- Monnify / Eso Pay (Supabase edge only — never in mobile bundle) ---
MONNIFY_ENV="sandbox"
MONNIFY_API_KEY="your-monnify-api-key"
MONNIFY_SECRET_KEY="your-monnify-secret-key"
MONNIFY_CONTRACT_CODE="your-monnify-contract-code"
# Sandbox virtual accounts require an 11-digit test BVN on the reserve-account API (v2).
MONNIFY_SANDBOX_BVN="22222222222"
# MONNIFY_SANDBOX_NIN="12034875601"
# MONNIFY_BASE_URL="https://sandbox.monnify.com"
# Optional defaults when paying legacy bills without a mapped provider:
# MONNIFY_DEFAULT_BILLER_CODE=""
# MONNIFY_DEFAULT_PRODUCT_CODE=""

# ESO_PAY_DEFAULT_TARIFF_NGN_PER_KWH="65"

# --- Enode (server / edge functions only — never in mobile bundle) ---
ENODE_ENV="sandbox"
ENODE_CLIENT_ID="your-enode-client-id"
ENODE_CLIENT_SECRET="your-enode-client-secret"
ENODE_WEBHOOK_SECRET="minimum_32_char_webhook_signing_secret"
ENODE_LINK_REDIRECT_URI="esoenergymobile://link-device/callback"
ENODE_JOBS_BASE_URL="https://app.eso-energy.com/api/enode"
ENODE_JOB_TOKEN="generate_64_hex_chars_and_store_as_secret"

# Web Link callback (Vite client)
# Production:
# VITE_ENODE_LINK_REDIRECT_URI="https://app.eso-energy.com/link-device/callback"
# VITE_ENODE_API_URL="https://app.eso-energy.com/api/enode"
# LAN dev:
VITE_ENODE_LINK_REDIRECT_URI="http://10.110.187.192:5178/link-device/callback"
# VITE_ENODE_API_URL="http://10.110.187.192:5178/api/enode"
# VITE_ENODE_API_URL="https://YOUR_PROJECT_REF.supabase.co/functions/v1/enode-api"
