{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "eso-energy-app",
  "compatibility_date": "2025-09-24",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server.ts",
  "workers_dev": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  // Custom domain — Cloudflare creates DNS + TLS when zone is on the same account.
  "routes": [
    {
      "pattern": "app.eso-energy.com",
      "custom_domain": true
    }
  ],
  "vars": {
    "AUTH_URL": "https://app.eso-energy.com",
    "TOTP_ISSUER": "ESO Energy Command Deck",
    "WEBAUTHN_RP_ID": "app.eso-energy.com",
    "WEBAUTHN_ORIGIN": "https://app.eso-energy.com",
    "ENODE_JOBS_BASE_URL": "https://app.eso-energy.com/api/enode"
  }
}
